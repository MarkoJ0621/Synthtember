{
  "name": "my-new-app",
  "productName": "my-new-app",
  "version": "1.0.0",
  "description": "My Electron application description",
  "main": ".webpack/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "build": "npm run webpack && electron-builder",
    "webpack": "webpack --config webpack.main.config.js && webpack --config webpack.renderer.config.js",
    "dist": "npm run build",
    "publish": "electron-forge publish",
    "lint": "echo \"No linting configured\""
  },
  "build": {
    "appId": "com.yourname.my-new-app",
    "productName": "My New App",
    "directories": {
      "output": "dist"
    },
    "files": [
      ".webpack/**/*",
      "src/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "target": "dmg"
    }
  },
  "keywords": [],
  "author": {
    "name": "MarkoJ0621",
    "email": "markolemesos@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.8.1",
    "@electron-forge/maker-deb": "^7.8.1",
    "@electron-forge/maker-rpm": "^7.8.1",
    "@electron-forge/maker-squirrel": "^7.8.1",
    "@electron-forge/maker-zip": "^7.8.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.1",
    "@electron-forge/plugin-fuses": "^7.8.1",
    "@electron-forge/plugin-webpack": "^7.8.1",
    "@electron/fuses": "^1.8.0",
    "@vercel/webpack-asset-relocator-loader": "^1.7.3",
    "copy-webpack-plugin": "^13.0.0",
    "css-loader": "^6.11.0",
    "electron": "36.4.0",
    "electron-builder": "^26.0.12",
    "node-loader": "^2.1.0",
    "style-loader": "^3.3.4",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@csound/browser": "^6.18.7",
    "@mediapipe/tasks-vision": "^0.10.22-rc.20250304",
    "electron-squirrel-startup": "^1.0.1",
    "hydra-synth": "^1.3.29",
    "p5": "^2.0.3"
  }
}