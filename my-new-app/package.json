{
  "name": "my-new-app",
  "productName": "my-new-app",
  "version": "1.0.0",
  "description": "My Electron application description",
  "main": "dist/main/main.js",
  "author": {
    "name": "MarkoJ0621",
    "email": "markolemesos@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron-webpack dev",
    "build": "electron-webpack",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "copy-webpack-plugin": "^6.4.1",
    "css-loader": "^3.6.0",
    "electron": "36.4.0",
    "electron-builder": "^26.0.12",
    "electron-webpack": "^2.8.2",
    "node-loader": "^1.0.3",
    "style-loader": "^1.3.0",
    "webpack": "^4.47.0",
    "webpack-cli": "^3.3.12"
  },
  "dependencies": {
    "@csound/browser": "^6.18.7",
    "@mediapipe/tasks-vision": "^0.10.22-rc.20250304",
    "hydra-synth": "^1.3.29",
    "p5": "^2.0.3"
  },
  "build": {
    "appId": "com.markoj0621.mynewapp",
    "productName": "my-new-app",
    "files": [
      "dist/",
      "node_modules/",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.dll",
      "**/*.dylib",
      "**/*.so"
    ],
    "directories": {
      "buildResources": "build"
    },
    "extraResources": [
      {
        "from": "resources/csound",
        "to": "csound"
      }
    ],
    "mac": {
      "category": "public.app-category.music"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo"
    }
  }
}
